# Local development only. Copy to .env and choose a throwaway password.
LD_SUPERUSER_NAME=admin
LD_SUPERUSER_PASSWORD=replace-with-a-local-development-password
# Generate once: python3 -c 'import secrets; print(secrets.token_hex(20))'
# Keep the same value for repeatable tests, including after a data-volume reset.
LINKDING_TEST_API_TOKEN=
LINKDING_PORT=9090
# Optionally pin the Linkding version used for a reproduction.
LINKDING_IMAGE=sissbruecker/linkding:latest
